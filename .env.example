# RiskSense environment variables
#
# Every variable is optional. With none of them set, RiskSense runs with the
# keyless public data sources and the OpenFreeMap basemap.

# --- Hazard data -----------------------------------------------------------

# NASA FIRMS area API key. Optional: without it the adapter reads the public
# global 24h/7d CSV archives, which need no key. With it, detections are
# requested for the exact window and instrument set.
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- Map -------------------------------------------------------------------

# Vector tile style URL. Defaults to OpenFreeMap's "liberty" style, which is
# built from OpenStreetMap data and requires no key.
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Optional persistence for community reports ----------------------------
#
# Supabase is optional. Without these, community reports are held in an
# in-memory store that resets on restart, and the UI says so.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: server-side only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingestion service (optional, headless) --------------------------------

# Directory the ingestion runner writes its latest snapshot to.
INGESTION_OUTPUT_DIR=./data/local
