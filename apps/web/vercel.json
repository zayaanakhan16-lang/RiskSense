{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "[ -f ../../package.json ] && cd ../.. ; npm install",
  "buildCommand": "[ -f ../../package.json ] && cd ../.. ; npm run build --workspace apps/web",
  "functions": {
    "src/app/api/events/route.ts": { "maxDuration": 60 },
    "src/app/api/stats/route.ts": { "maxDuration": 60 },
    "src/app/api/archive/route.ts": { "maxDuration": 60 },
    "src/app/api/geocode/route.ts": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" }
      ]
    }
  ]
}
